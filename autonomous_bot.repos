repositories:
  src/livox_ros_driver2:
    type: git
    url: https://github.com/Livox-SDK/livox_ros_driver2.git
    version: 1.2.6
  src/emcl2_ros2:
    type: git
    url: https://github.com/CIT-Autonomous-Robot-Lab/emcl2_ros2.git
    version: main
  # 価値反復プランナ (vi_global_planner: 広域 / vi_local_planner: 狭域) を含む。
  # colcon では --packages-select でこの 2 つのみビルドする (vi_node /
  # vi_interfaces は ros2_rust の Docker 環境向けで、通常はビルド対象にしない)。
  src/value_iteration3:
    type: git
    url: https://github.com/NOPLAB/value_iteration3.git
    version: main
  # 取り込まないもの:
  #   * RaspberryPiMouse    — rtmouse カーネルモジュール。コンテナからは insmod
  #                           できないのでホスト側の責務のまま (raspicat_setup_scripts
  #                           が導入する)。コンテナは /dev/rt* を借りるだけ。
  #   * raspicat_slam_navigation / raspicat_speak2 / raspicat_setup_scripts
  #                         — 本リポジトリのナビゲーションでは使わない。
  src/raspicat_ros:
    type: git
    url: https://github.com/CIT-Autonomous-Robot-Lab/raspicat_ros.git
    version: ros2
  src/raspicat_description:
    type: git
    url: https://github.com/CIT-Autonomous-Robot-Lab/raspicat_description.git
    version: ros2
  src/raspimouse2:
    type: git
    url: https://github.com/CIT-Autonomous-Robot-Lab/raspimouse2.git
    version: master
