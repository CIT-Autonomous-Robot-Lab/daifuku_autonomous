repositories:
  src/emcl2_ros2:
    type: git
    url: https://github.com/CIT-Autonomous-Robot-Lab/emcl2_ros2.git
    version: main
  # 価値反復プランナ (vi_global_planner: 広域 / vi_local_planner: 狭域) を含む。
  # colcon では --packages-select でこの 2 つのみビルドする (vi_node /
  # vi_interfaces は ros2_rust の Docker 環境向けで、通常はビルド対象にしない)。
  src/value_iteration3:
    type: git
    url: https://github.com/NOPLAB/value_iteration3.git
    version: main
