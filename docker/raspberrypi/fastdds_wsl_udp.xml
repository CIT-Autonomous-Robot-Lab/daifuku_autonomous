<?xml version="1.0" encoding="UTF-8"?>
<!--
  WSL用。別ホストを同一ホストと誤認するSHMを避け、UDPだけを使う。
  ロボット側はfastdds_udp_whitelist.xmlで同一ホストのSHMを維持する。
  UDPパケットを小さくし、loopbackと自分のロボットLANアドレスだけを広告する。
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>wsl_small_udp</transport_id>
      <type>UDPv4</type>
      <maxMessageSize>1400</maxMessageSize>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>192.168.1.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="wsl_small_udp_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>wsl_small_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
