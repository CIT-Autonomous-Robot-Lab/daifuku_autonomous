<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>daifuku_waypoint_manager</name>
  <version>0.1.0</version>
  <description>Waypoint の作成・保存・巡回を行う RViz2 パネルプラグイン</description>
  <maintainer email="noplab90@gmail.com">Keita Sekiguchi / nop</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>qtbase5-dev</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rviz_common</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>

  <!-- ament_lint_common (詰め合わせ) は使わず、走らせるものだけを名指しする。
       flake8 は Python が無いので入れない。外してあるのは C++ の書式 lint
       (uncrustify / cpplint) で、理由は CLAUDE.md。 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz_common plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
