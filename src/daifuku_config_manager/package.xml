<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>daifuku_config_manager</name>
  <version>0.1.0</version>
  <description>設定ファイルの合成規則と、場所ごとの調整 (overrides) を持つ共有パッケージ</description>
  <maintainer email="noplab90@gmail.com">Keita Sekiguchi / nop</maintainer>
  <license>Apache-2.0</license>

  <!-- 葉のパッケージ。daifuku_bringup と daifuku_stack の両方がこれに依存し、
       この 2 つは互いに依存しない。ここから両者を参照してはいけない
       (参照した瞬間に循環する)。 -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- 設定の実体は持たないが、**その在処は引く** (params.overrides_dir /
       config_root / site_file が daifuku_config の share を指す)。宣言が抜けて
       いると、依存だけを並べる環境 (colcon test) で PackageNotFoundError になる。
       daifuku_config は他へ依存しない葉なので、これで循環はしない。 -->
  <exec_depend>daifuku_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- launch から config_sentinel を立てるため (params.sentinel_actions)。
       import は関数の中に置いてあるので、ノードを立てない環境では読まれない。 -->
  <exec_depend>launch_ros</exec_depend>

  <!-- site_manager と config_sentinel。std_msgs は /daifuku/site の String、
       nav_msgs は静止判定の Odometry、rcl_interfaces は SetParametersResult。 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <!-- test/ の各 test_*.py と対。pep257 は外してある (理由は AGENTS.md)。 -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- test/test_*_launch.py (launch_testing の統合テスト)。pytest の plugin は
       launch_testing 側が登録するので、CMake の add_launch_test は要らない。 -->
  <test_depend>launch_testing</test_depend>
  <!-- test_site_manager_launch.py が `ros2 param set` を実際に叩く
       (AGENTS.md が案内している切り替えの口そのもの)。 -->
  <test_depend>ros2param</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
