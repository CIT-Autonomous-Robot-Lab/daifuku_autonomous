<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>raspicat_driver</name>
  <version>0.1.0</version>
  <description>Raspberry Pi Cat の本体ドライバ (Pi 4 / Pi 5 のユーザ空間実装)</description>
  <maintainer email="noplab90@gmail.com">Keita Sekiguchi / nop</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <!-- Leds と Switches。公式実装と同じ型でなければ差し替えの意味がないので、
       raspimouse2 (vcs import) のこのパッケージだけは自前実装からも参照する。 -->
  <exec_depend>raspimouse_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- test/ の各 test_*.py と対。pep257 は外してある (理由は CLAUDE.md)。 -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
