# これを `.env` にコピーして機体ごとに書き換える (`.env` は .gitignore)。
#
#   cp .env.example .env
#
# COMPOSE_FILE を置いておくと、リポジトリルートから `-f` 無しで叩ける:
#
#   docker compose up -d
#   docker compose logs -f raspicat
#   docker compose exec ros2 /ros_entrypoint.sh bash
#
# **cd した先では効かない** (Compose が COMPOSE_FILE を読むのはカレントディレクトリ
# の .env)。リポジトリルートから叩くこと。`-f` を明示したときはそちらが優先される
# ので、開発用の docker/dev/ は今までどおり。

# 本体ドライバの選択。この 2 つは排他で、どちらか 1 行だけを有効にする。
#
#   compose.original.yaml  自前実装 (src/raspicat_driver)。Pi 5 では必須。既定
#   compose.rt.yaml        公式実装 (raspimouse + rtmouse)。**Pi 4 専用**
#
# 取り違えると: rt を Pi 5 で立てると configure で落ちる。original を rtmouse を
# 載せた Pi 4 で立てるとノードが起動時に拒否する (GPIO の二重掴みを防ぐため)。
COMPOSE_FILE=docker/raspberrypi/compose.original.yaml
#COMPOSE_FILE=docker/raspberrypi/compose.rt.yaml

# Mid-360 の IMU と車輪オドメトリを EKF で融合するか。**既定 true**。
#
# 読むのは raspicat サービス 1 つだけ。robot_bringup.launch.py が本体ドライバと EKF
# (odom_fusion.launch.py) の両方を立てるので、この 1 行で「ドライバは /wheel/odom を
# 出して TF を止める」と「EKF が /odom と odom -> base_footprint を出す」が同時に
# 切り替わる。**片方だけという状態は作れない。**
#
# 変えたら `docker compose up -d` でコンテナを作り直すこと (環境変数は起動時に
# 読まれるので、走っているコンテナには入らない)。
#
# 既定のまま使うときの注意。**機体の電源投入時は静止させておくこと。** Mid-360 の
# ジャイロは電源投入時バイアスが大きく (実測 +0.80 deg/s = 48 deg/min)、
# prepare_mid360_imu が起動後の静止区間から測って引くため。動いていると測れず、
# ログに still moving が出るだけで補正なしのまま通る。**compose up (と Pi の再起動)
# の時点が測定のタイミング**で、navigation を立てるときではない。
#
# LIDAR=2d との併用はできない (URG に IMU が無いため起動時にエラーで止まる)。
#
# 詳細は docs/setup/lidar.md。
#USE_MID360_IMU=true

# LiDAR の構成。**既定 mid360** (本機の構成)。2d は raspicat の URG。
# raspicat サービスの command に展開される。
#LIDAR=mid360

# cargo を crates.io へ出さないか。**ロボット LAN にゲートウェイが無い機体では
# true にすること** (`ip route` にデフォルトルートが無い構成)。
#
# クレートのキャッシュが揃っていても、cargo はレジストリの index を更新しに
# いく。名前が引けないと vi_planner が `unable to update registry` で落ち、
# `set -e` で `docker compose up` ごと止まる (2026-08-07 に踏んだ)。クレートは
# build ボリュームの .cargo に残るので、一度取れていれば true で通る。
#
# **新しいクレートを足したときだけ** wlan0 を上げて false に戻すこと。キャッシュ
# に無いものは offline mode と明示して落ちるので、黙って古い版で建つことはない。
#CARGO_NET_OFFLINE=true

# ── BUILD_JOBS / ROS_DOMAIN_ID / INPUT_GID をここに書くときの注意 ──────────────
#
# **.env は 2 つ読まれる。** ここ (カレントディレクトリ) と、compose ファイルの
# 置き場である docker/raspberrypi/.env の両方で、値は合成される。**同じキーが
# 両方にあると docker/raspberrypi/.env が勝つ**（Compose の project directory は
# COMPOSE_FILE の 1 つめのあるディレクトリで、そちらが後勝ちになる）。
#
# docker/raspberrypi/.env は provision.sh が ROS_DOMAIN_ID と BUILD_JOBS を書いて
# 生成する。実機で「ここを直したのに効かない」ときは、まず向こうを見ること。
# COMPOSE_FILE だけはここでしか効かない（向こうを読む時点でもう遅い）。
#
# 以下は docker/raspberrypi/.env が無い環境 (開発ホストなど) 向け。

# colcon とイメージビルドの並列数。既定 4 = Pi 4 の全コア。OOM で落ちるときだけ下げる。
#BUILD_JOBS=4

# ROS 2 のドメイン。機体とデバッグ用ホストで一致していること。
#ROS_DOMAIN_ID=90

# ホストの input グループ GID (`getent group input`)。joy_node が
# /dev/input/event* を開くのに要る。イメージを焼き直して番号が変わったときだけ。
#INPUT_GID=995
